# Copy to .env (project root) — used by Hardhat and the circuit build.

# Local node URL for `--network localhost`
# LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Deploy to another network with `--network remote`
# DEPLOY_RPC_URL=https://sepolia.example.org
# DEPLOYER_PRIVATE_KEY=0x...

# Powers of Tau file from a public ceremony (strongly recommended beyond local
# development), e.g. powersOfTau28_hez_final_14.ptau
# PTAU_PATH=build/ptau/powersOfTau28_hez_final_14.ptau

# circom 2.x binary (default: tools/circom(.exe), then `circom` on PATH)
# CIRCOM_PATH=
