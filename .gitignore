# Circuit build intermediates (regenerated by `npm run circuit:build`).
# Kept: build/verification_key.json, build/main_js/main.wasm, build/vote_final.zkey
# and client/public/zk/* so the app runs without rebuilding.
build/ptau/
build/*.r1cs
build/*.sym
build/*.wtns
build/main_js/*.js
build/proof.json
build/public.json
build/vote-request.json
circuits/main.circom

# Electoral roll: contains voters' email addresses (personal data). The public,
# email-free registry is client/public/voterProofData.json.
data/voters.json
data/admin-log.jsonl
data/*.tmp
data/backup-*/

# Local tool binaries (circom)
tools/

# Backups
*.backup.json
