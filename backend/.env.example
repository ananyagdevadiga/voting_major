# Copy to backend/.env and adjust.

PORT=3000

# JSON-RPC endpoint of the chain the Voting contract is deployed on
RPC_URL=http://127.0.0.1:8545

# Relayer wallet that submits vote transactions (it only pays gas; the
# contract verifies every proof). The value below is Hardhat's public test
# account #0 — use it ONLY with a local `npx hardhat node`.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract owner wallet, used by the admin portal (/admin) to close
# registration, open voting and end the election. Must be the account that
# ran `npm run deploy` — on a local `npx hardhat node` that is the same test
# account #0 as above. Leave empty to keep phase changes in the terminal.
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Admin portal password, stored as a scrypt hash. Set it with
#   npm run admin:set-password
# (the portal is disabled while this is empty).
ADMIN_PASSWORD_HASH=

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Email for registration codes. Leave SMTP_HOST empty in development and the
# emails (including codes) are printed to the backend console instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<address>,
# SMTP_PASS=<16-character app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SecureVote <no-reply@securevote.local>

# Optional overrides (paths are relative to the project root)
# CONTRACT_INFO_PATH=contractAddress.json
# ELECTION_CONFIG_PATH=election.config.json
# VERIFICATION_KEY_PATH=build/verification_key.json
# MERKLE_PATH=data/merkle.json
# VOTER_PROOF_DATA_PATH=client/public/voterProofData.json
# ADMIN_LOG_PATH=data/admin-log.jsonl
# VOTERS_PATH=data/voters.json
